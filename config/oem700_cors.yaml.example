# Copy to config/oem700_cors.yaml (gitignored). Password never goes in git.
# Port 8002 is Sixents WGS84, epoch 2010.0. Mount point is the account's
# RTCM32_GRECJ2 stream, not the manual's sample mount.
host: vrs.sixents.com
port: 8002
mount_point: RTCM32_GRECJ2
username: YOUR_ACCOUNT
password: YOUR_PASSWORD
upload_gga: 1
